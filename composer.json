{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "artesaos/seotools": "^1.4",
        "awssat/laravel-visits": "^6.3",
        "guzzlehttp/guzzle": "^7.15.2",
        "jorenvanhocht/laravel-share": "^4.2",
        "laravel-lang/locales": "^2.11",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.6",
        "laravel/tinker": "^3.0",
        "matomo/device-detector": "^6.5",
        "morilog/jalali": "^3.5",
        "nwidart/laravel-modules": "^13.0",
        "pbmedia/laravel-ffmpeg": "^8.9",
        "realrashid/sweet-alert": "^7.3",
        "rtconner/laravel-likeable": "^3.2",
        "spatie/laravel-feed": "^4.5",
        "spatie/laravel-honeypot": "^4.7",
        "spatie/laravel-markdown": "^2.8",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-sitemap": "^8.2",
        "torann/geoip": "^3.0.10"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.24",
        "laravel-lang/common": "^6.8",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.5.12",
        "roave/security-advisories": "dev-latest",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        },
        "files": [
          "Modules/Common/App/Helpers/view_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
