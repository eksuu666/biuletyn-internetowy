APP_NAME="sŁodziak"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://twoja-domena.pl
APP_TIMEZONE=Europe/Warsaw
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=slodziak
DB_USERNAME=slodziak
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=redakcja@twoja-domena.pl
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_FULL_NAME="Redakcja sŁodziak"
ADMIN_USERNAME=redakcja
ADMIN_EMAIL=admin@twoja-domena.pl
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
PANEL_PREFIX=redakcja

CONTACT_ADDRESS="Łódź, Polska"
CONTACT_EMAIL=redakcja@twoja-domena.pl
CONTACT_PHONE=

HTTP_PORT=8080
APP_IMAGE_TAG=latest
